# KAIROS Health — Environment Variables
#
# Variables marked [REQUIRED] will cause the app to crash in production
# if they are empty or missing.  All other variables are optional and
# fall back to sensible defaults.
#
# See src/lib/config/env.ts for the full validation logic.

# ─── Clerk Authentication [REQUIRED in production] ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/1

# ─── Database (PostgreSQL / Neon) [REQUIRED in production] ───
DATABASE_URL=postgresql://kairos:password@localhost:5432/kairos_dev

# ─── Redis (optional, for caching) ───
REDIS_URL=redis://localhost:6379

# ─── Stripe [REQUIRED in production] ───
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Email (Resend) ───
RESEND_API_KEY=re_...
EMAIL_FROM=KAIROS Health <noreply@kairos.health>

# ─── SMS (Twilio) ───
# Required to send notification SMS. If any are missing, SMS delivery is
# skipped (notifications stay "pending"). Set TWILIO_FROM_NUMBER as an E.164
# number, OR use TWILIO_MESSAGING_SERVICE_SID instead of a from number.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567
# TWILIO_MESSAGING_SERVICE_SID=MG...

# ─── Push (Expo) ───
# Expo push delivery needs no server secret — it is gated on registered
# device tokens (see the push_tokens table / registerPushToken mutation).

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# ─── Cron Jobs [REQUIRED in production] ───
CRON_SECRET=your-cron-secret-here

# ─── Device Integrations (OAuth) ───
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_WEBHOOK_SECRET=

DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_WEBHOOK_SECRET=

GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_WEBHOOK_SECRET=

FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_WEBHOOK_SECRET=

# ─── Google Calendar (coach calendar integration — Calendly-style) ───
# Coaches connect their Google Calendar; busy times auto-remove conflicting
# bookable slots. Optional — when unset, the feature is disabled and nothing
# breaks. Create an OAuth 2.0 Client (Web application) in Google Cloud Console
# with the Calendar API enabled, and register this exact Authorized redirect URI:
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
#   (e.g. http://localhost:3000/api/integrations/google/callback in dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Microsoft / Outlook Calendar (coach calendar integration) ───
# Coaches connect their Outlook / Microsoft 365 calendar; busy times auto-remove
# conflicting bookable slots, and client-facing emails can be sent from their own
# mailbox. Optional — when unset, the feature is disabled and nothing breaks.
# Register an app in the Microsoft Entra (Azure AD) portal with a Web platform
# and delegated permissions (offline_access, User.Read, Calendars.ReadWrite,
# Mail.Send), then add this exact Redirect URI:
#   ${NEXT_PUBLIC_APP_URL}/api/integrations/microsoft/callback
#   (e.g. http://localhost:3000/api/integrations/microsoft/callback in dev)
# MICROSOFT_TENANT_ID defaults to "common" (multi-tenant + personal accounts).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ─── Feature Flags (defaults shown, override as needed) ───
# ENABLE_DEMO_MODE=false
# ENABLE_REALTIME=true
# ENABLE_DEVICE_SYNC=false
# ENABLE_LAB_ORDERING=false
# ENABLE_COACH_MESSAGING=false

# ─── Performance (optional) ───
# CACHE_MAX_SIZE=5000
# RATE_LIMIT_ENABLED=true
